<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Keep your console logs visible inside IntelliJ -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Use the dedicated OpenTelemetry OTLP Outbound Appender -->
    <appender name="OTLP" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureContextDataAttributes>true</captureContextDataAttributes>
    </appender>

    <!-- Activate both the console output and the OTLP network exporter -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTLP"/>
    </root>
</configuration>
